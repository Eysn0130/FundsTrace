{
  "name": "funds-trace-desktop",
  "productName": "FundsTrace",
  "version": "0.1.11",
  "private": true,
  "author": "FundsTrace contributors",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Independent FundsTrace desktop host",
  "main": "main.cjs",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "start": "electron .",
    "synthetic": "electron . --synthetic",
    "issuer": "electron issuer/main.cjs",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --config electron-builder.cjs --publish never",
    "pack:win": "electron-builder --win nsis --x64 --config electron-builder.cjs --publish never",
    "pack:issuer:win": "electron-builder --win nsis --x64 --config issuer/electron-builder.cjs --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
