{
  "name": "funds-trace-desktop",
  "productName": "FundsTrace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "author": "FundsTrace contributors",
  "license": "MIT",
  "description": "Independent FundsTrace desktop host",
  "main": "main.cjs",
  "engines": { "node": "22.22.1" },
  "scripts": {
    "start": "electron .",
    "synthetic": "electron . --synthetic",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --config electron-builder.cjs",
    "pack:win": "electron-builder --win nsis --x64 --config electron-builder.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
